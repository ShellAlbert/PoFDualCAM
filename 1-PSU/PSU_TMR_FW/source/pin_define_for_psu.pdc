ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports oLED1]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports oLED2]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports oLED3]
ldc_set_location -site {39} [get_ports oLED1]
ldc_set_location -site {40} [get_ports oLED2]
ldc_set_location -site {41} [get_ports oLED3]
ldc_set_vcc -bank 0 -derate 1
ldc_set_vcc -bank 0 1.8
ldc_set_vcc -bank 1 1.8
ldc_set_vcc -bank 2 1.8
ldc_set_vcc -bank 1 -derate 1
ldc_set_vcc -bank 2 -derate 1
ldc_set_port -iobuf {IO_TYPE=LVCMOS18 PULLMODE=NA DRIVE=4} [get_ports oIAM_ALIVE]
ldc_set_location -site {9} [get_ports oIAM_ALIVE]
ldc_set_vcc -core 1.2
